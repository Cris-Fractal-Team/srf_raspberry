using namespace std;

int ejecutaDemo()
{

    // Cargar el modelo de reconocimiento facial (FaceRecognizerSF)
    std::string model_path = "/home/mchu/proyectos/vc_tensorflow_2024-dlib-64bits/face_recognition_sface_2021dec.onnx";  // Ruta al modelo ONNX
    std::string face_detector_path = "/home/mchu/proyectos/vc_tensorflow_2024-dlib-64bits/haarcascade_frontalface_default.xml";  // Clasificador Haar
    std::string ynface_detector_path = "/home/mchu/proyectos/vc_tensorflow_2024-dlib-64bits/face_detection_yunet_2023mar_int8.onnx";  // Clasificador Haar


    // Crear FaceRecognizerSF y el clasificador de rostros
    cv::Ptr<cv::FaceRecognizerSF> recognizer = cv::FaceRecognizerSF::create(model_path, "");
    cv::Ptr<cv::FaceDetectorYN> detector = cv::FaceDetectorYN::create(ynface_detector_path, "", cv::Size(320,320), 0.6f, 0.3f, 500, 0,0);
    
    // Cargar la imagen con un rostro
    cv::Mat img1 = cv::imread("/home/mchu/Pictures/foto1.png");
    cv::Mat img2 = cv::imread("/home/mchu/Pictures/foto1.png");
    
    static cv::Scalar box_color{0, 255, 0};
    static std::vector<cv::Scalar> landmark_color{
        cv::Scalar(255,   0,   0), // right eye
        cv::Scalar(  0,   0, 255), // left eye
        cv::Scalar(  0, 255,   0), // nose tip
        cv::Scalar(255,   0, 255), // right mouth corner
        cv::Scalar(  0, 255, 255)  // left mouth corner
    };
    static cv::Scalar text_color{0, 255, 0};
      
    // escala todo
    float escalaHor, escalaVer;

    escalaHor = ((float)img1.cols)/320.0 ;
    escalaVer = ((float)img1.rows)/320.0 ;

   
    auto start = std::chrono::high_resolution_clock::now();

    // detectamos con YN
    cv::Mat faces;
    cv::Mat imgEscalada;

    cv:resize(img1, imgEscalada, cv::Size(320,320));   
    detector->detect(imgEscalada, faces);
        
    cv::Mat imgOrig = img1.clone();

    for (int i = 0; i < faces.rows; ++i)
    {
        // Draw bounding boxes
        float x1 = (faces.at<float>(i, 0));
        float y1 = (faces.at<float>(i, 1));
        float w = (faces.at<float>(i, 2));
        float h = (faces.at<float>(i, 3));

        x1*= escalaHor;
        w*= escalaHor;
        y1*= escalaVer;
        h*= escalaVer;

        faces.at<float>(i, 0) = x1;
        faces.at<float>(i, 1) = y1;
        faces.at<float>(i, 2) = w;
        faces.at<float>(i, 3) = h;

        cv::rectangle(img1, cv::Rect((int)x1, (int)y1, (int)w, (int)h), box_color, 2);

        // Confidence as text
        float conf = faces.at<float>(i, 14);
        cv::putText(img1, cv::format("%.4f", conf), cv::Point(x1, y1+12), cv::FONT_HERSHEY_DUPLEX, 0.5, text_color);

        // Draw landmarks
        for (int j = 0; j < landmark_color.size(); ++j)
        {
            x1 = faces.at<float>(i, 2*j+4)*escalaHor;
            faces.at<float>(i, 2*j+4) = x1;
            int x = (int)x1;

            y1 = faces.at<float>(i, 2*j+5)*escalaVer;
            faces.at<float>(i, 2*j+5) = y1;
            int y = (int)y1;

            cv::circle(img1, cv::Point(x, y), 2, landmark_color[j], 2);
        }
    }

    auto end1 = std::chrono::high_resolution_clock::now();

    // Alinear y recortar el rostro usando el rect�ngulo del rostro
    cv::Mat aligned_face;
    recognizer->alignCrop(imgOrig, faces, aligned_face);  // Alinear el rostro usando el rect�ngulo detectado

    cout << "Cara Alineada : " << aligned_face.cols << " x " << aligned_face.rows << endl;

    auto end2 = std::chrono::high_resolution_clock::now();


    cv::Mat target_features;
    recognizer->feature(aligned_face, target_features);

    cout << "Caracteristicas: " << target_features.rows << " " << target_features.row(0).cols << endl;


    auto end3 = std::chrono::high_resolution_clock::now();

     // Calcular la duraci�n entre el inicio y el final
    std::chrono::duration<double, std::milli> duration1 = end1 - start;
    std::chrono::duration<double, std::milli> duration2 = end2 - end1;
    std::chrono::duration<double, std::milli> duration3 = end3 - end2;
    std::chrono::duration<double, std::milli> duration4 = end3 - start;

    // Mostrar el tiempo en segundos
    std::cout << "Tiempo de detecta: " << duration1.count() << " ms" << std::endl;
    std::cout << "Tiempo de alinea: " << duration2.count() << " ms" << std::endl;
    std::cout << "Tiempo de genera descr: " << duration3.count() << " ms" << std::endl;
    std::cout << "Tiempo total: " << duration4.count() << " ms" << std::endl;

    // Mostrar el rostro alineado
    cv::imshow("Rostro alineado", aligned_face);
    cv::imshow("Orig", img1);
    cv::waitKey(0);

    cv::destroyAllWindows();

    return 0;
}
 



