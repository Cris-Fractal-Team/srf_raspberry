void testVector1()
{
    GVector partes = GStringUtils::split("id=que%20chucha&nombre=marko%20chu","&");
    int i,n,posIgual;
    GStringObject *obj;
    string param,valor;

    n = partes.size();

    cout << "EL query string tiene " << n << " Tokens" << endl;
    for(i=0;i<n;i++)
    {
        obj = (GStringObject *)partes.get(i).get();
        cout << "Procesando el token : " << obj->valor << endl;
        posIgual = obj->valor.find("=");
        if ( posIgual >= 0 )
        {
            param = obj->valor.substr(0,posIgual);
            valor =  GStringUtils::decode_URLEncodedString(obj->valor.substr(posIgual+1));

            cout << "Nombre: " << param << " Valor: " << valor << endl;            
        } 
        else
        {
            cout << "El token no tiene valor" << endl;                        
        }
    }

    
}

void testJson()
{
    string json("{ \"numero1\" : 1234 , \"numero2\": +45, \"numero3\" :   -56   ,  \"numero4\" :   56.5 ,\"numero5\":   -100.5 ,  ");

    json.append("\"txt1\":\"primero\", \"txt2\":  \"segundo\",  \"txt3\"  :  \"tercero\" ,");

    json.append(" \"numero6\" : 1234, \"txt4\" : \"Primera linea\n\\\"Segunda\\\"\" ,");

    json.append("\"cliente\" : {\"nombre\" :\"carlos\", \"apellido\" :\"perez\",\"edad\" :-45.8  , ");

    json.append("\"telefonos\" : [\"(+45)1122\",\"(+51)3344\",\"(+01)666999\"],");
    
    json.append("\"notas\": [");

    json.append("{\"curso\" :\"matematica\",\"nota\" :20, \"profesor\":\"baldor\"}  ");
    json.append("{\"curso\" :\"fisica\",\"nota\" :16, \"profesor\":\"isac newton\"} ");
    json.append("{\"curso\" :\"religion\",\"nota\" : 13, \"profesor\":\"el curita\"} ");
    json.append("{\"curso\" :\"historia\",\"nota\" :19, \"profesor\":\"julio ctello\"} ");

    json.append("]");

    json.append("}}");

    int rpta;
    GHashMap map = GJson::parse(json,&rpta);

    cout << "Resultado del parse: " << rpta << endl;
    if ( rpta == 0 )
    {        
        cout << "Numero1= " << map.getDouble("numero1",-1) << endl;
        cout << "Numero2= " << map.getDouble("numero2",-1) << endl;
        cout << "Numero3= " << map.getDouble("numero3",-1) << endl;
        cout << "Numero4= " << map.getDouble("numero4",-1) << endl;
        cout << "Numero5= " << map.getDouble("numero5",-1) << endl;
        cout << "Numero6= " << map.getDouble("numero6",-1) << endl;

        cout << "txt1= " << map.getString("txt1") << endl;
        cout << "txt2= " << map.getString("txt2") << endl;
        cout << "txt3= " << map.getString("txt3") << endl;
        cout << "txt4= " << map.getString("txt4") << endl;

        GHashMap mapa = map.getHashMap("cliente");

        cout << "Cliente.nombre : " << mapa.getString("nombre") << endl;
        cout << "Cliente.apellido : " << mapa.getString("apellido") << endl;
        cout << "Cliente.edad : " << mapa.getDouble("edad",-1) << endl;

        GVector telefonos = mapa.getVector("telefonos");

        cout << "Vector de telefonos obtenido, tiene : " << telefonos.size() << " elementos" << endl;
        for(int i=0;i<telefonos.size();i++)
        {
            cout << "Telefono " << i << ":" << ((GStringObject *)telefonos.get(i).get())->valor << endl;
        }

        GVector cursos = mapa.getVector("notas");
        cout << "Vector de crusos obtenido, tiene : " << cursos.size() << " elementos" << endl;
        for(int i=0;i<cursos.size();i++)
        {
            GHashMap *curso = (GHashMap *)cursos.get(i).get();
            cout << "Cursor " << i << ":" << curso->getString("curso") << " => " << curso->getDouble("nota",-1) ;
            cout << " Profesor " <<  curso->getString("profesor")  << endl;
        }
    }
}

/**
 * Test de detecciones
 */
void testDetecciones()
{
    // Mat imagen;
    GImage imagen;
    int anchoVideo,alturaVideo;


    DeteccionVO *deteccion; 
    std::shared_ptr<GVector> detecciones = NULL;
    std::shared_ptr<GVector> deteccionesTmp = NULL;

    int i,fd,Fcnt=0;
    chrono::steady_clock::time_point Tbegin, Tend, TiniInf, Tfininf;
    float FPS[16];
    float f,f2,f3;

    // Inicializa la camara
    GCamara camara;
    anchoVideo = 1280;
    alturaVideo = 720;

    camara.usarLibCamara = true;
    camara.setDim(anchoVideo,alturaVideo);
    camara.setCamara("/dev/video0");
    camara.reflejarVerticalmente = 1;

    if ( camara.iniciarCaptura() != 0)
    {
        cout << "Error al inicializar la camara" << endl;
        return;
    }

    // Inicializa la fuente de imagenes
    DetectorImageSource imageSource;
    imageSource.setDimImgModelo(300,300);

    // Inicializa el thread detector
    ThreadDetector thDetector;   
    thDetector.cargaEtiquetas("./caras.txt");
    thDetector.setDimImgModelo(300,300,3);
    thDetector.setDimImgOrig(anchoVideo,alturaVideo);
    thDetector.setPathModelo("face_labels_list.tflite");
    thDetector.imageSource = &imageSource;
    // thDetector.getDetector()->setNumThreads(2);
    thDetector.iniciar();
    
    for(i=0;i<16;i++) FPS[i]=0.0;
            
    TiniInf = chrono::steady_clock::now();
    Tend = chrono::steady_clock::now();
    cout << "Inicia bucle principal" << endl;
    while( 1 )
    {
        Tbegin = chrono::steady_clock::now();     

        // Captura la imageb
        imagen = camara.leerCamara();
        if ( camara.errorEnLectura != 0 )
        {
            cout << "Error al leer imagen desde la camara" << endl;
            break;
        }

        // guarda la imagen en la fuente de imagenes
        imageSource.setImage(imagen);

        // obtiene las detecciones actuales
        deteccionesTmp = thDetector.getDetecciones();
        if ( deteccionesTmp != NULL )
        {
            if ( detecciones != NULL )
            {
                // libera la ram de la lista de detecciones
                detecciones.reset();
            }
            Tfininf = chrono::steady_clock::now();
            f2 = chrono::duration_cast <chrono::milliseconds> (Tfininf - TiniInf).count();
            TiniInf = Tfininf;
            detecciones =  deteccionesTmp;
        }

        if ( detecciones !=  NULL  )
        {
            string txt;

            // dibuja las detecciones
            for(i=0;i<detecciones->size();i++)
            {
                deteccion = (DeteccionVO *)detecciones->get(i).get();

                // cout << "Deteccion " << i << " Tipo " << deteccion->getType() << endl;
                GDibujo::drawRect(imagen,deteccion->region,GColor(0,0,255),2);
                
                // GDibujo::drawText(imagen,deteccion->region.x1,deteccion->region.y1-5,thDetector.getDetector()->etiquetas[deteccion->indiceClase],GDIBUJO_FONT_HELVETICA,GColor(0,0,255),0.5);

                // rectangle(imagen,deteccion->region, Scalar(0, 0, 255), 1, 8, 0);
                // putText(imagen, format("%s", thDetector.getDetector()->etiquetas[deteccion->indiceClase].c_str()), Point(deteccion->region.x, deteccion->region.y-5) ,FONT_HERSHEY_SIMPLEX,0.5, Scalar(0, 0, 255), 1, 8, 0);
            }
        }

        // calcula la velocidad de impresion
        Tend = chrono::steady_clock::now();
        f2 = chrono::duration_cast <chrono::milliseconds> (Tend - Tbegin).count();

        FPS[((Fcnt++)&0x0F)]=1000.0/f2;
        for(f=0.0, i=0;i<16;i++){ f+=FPS[i]; }
        f/=16;

        string cadena("FPS ");
        cadena.append(to_string(f));
        GDibujo::drawText(imagen,10,20,cadena,GDIBUJO_FONT_HELVETICA,GColor(0,0,255),0.8);

        string cadena2("FPS ");
        // cadena.append(to_string(f2));
        cadena2.append(to_string(thDetector.getTiempoUltInf()));
        GDibujo::drawText(imagen,250,20,cadena2,GDIBUJO_FONT_HELVETICA,GColor(0,0,255),0.8);
                
        // putText(imagen, format("FPS %0.2f",f),Point(10,20),FONT_HERSHEY_SIMPLEX,0.8, Scalar(0, 0, 255));
        // putText(imagen, format("FPS %0.2f",f2),Point(150,20),FONT_HERSHEY_SIMPLEX,0.8, Scalar(255, 0, 255));

        // cv::imshow("view", imagen);
        GDibujo::show(imagen,"view");
        // cout << "Se dibuja cuadro: " << f << " fps" << endl;
        // int key = cv::waitKey(1);

        int key = GDibujo::waitForKey(1);
        if ( key > 0 ) break;

        
        
    }

    cout << "Finaliza el programa" << endl;

    camara.detenerCaptura();    
    // destroyAllWindows();

    GDibujo::closeAllWindows();
}

// Funci�n para mapear el buffer a memoria
void *mapBuffer(const FrameBuffer::Plane &plane) {
    int fd = plane.fd.get();  // Obtener el descriptor del archivo del plane
    size_t length = plane.length;
    off_t offset = plane.offset;

    // Mapear el buffer en memoria
    void *mappedMemory = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, offset);
    if (mappedMemory == MAP_FAILED) {
        std::cerr << "Error al mapear el buffer." << std::endl;
        return nullptr;
    }

    return mappedMemory;
}


// Callback para manejar las capturas completadas
void onRequestCompleted(Request *request) {

    cout << "OnRquestCompleted:" << request->status() << endl;

    if (request->status() == Request::RequestComplete) {
        // Obtener el buffer que contiene los datos capturados
        FrameBuffer *buffer = request->buffers().begin()->second;
        if (!buffer) {
            std::cerr << "Error al obtener el buffer." << std::endl;
            return;
        }

        // Mapear la memoria del buffer
        void *data = mapBuffer(buffer->planes()[0]);
        if (!data) {
            std::cerr << "Error al mapear la memoria del buffer." << std::endl;
            return;
        }

        // Crear una imagen OpenCV a partir de los datos
        cv::Mat image(720, 1280, CV_8UC3, data);  // CV_8UC3: 8 bits por canal, 3 canales (RGB)

        // Mostrar la imagen usando OpenCV
        cv::imshow("Vista en Vivo (As�ncrono)", image);
        cv::waitKey(1);  // Refrescar la ventana

        // Desmapear la memoria
        munmap(data, buffer->planes()[0].length);
    }
}

/**
 * Test camara segun chatgpt
 */
int testChatGpt()
{
    // Crear el CameraManager
    CameraManager *cameraManager = new CameraManager();

    // Iniciar el CameraManager
    cameraManager->start();

    // Obtener la primera c�mara disponible
    if (cameraManager->cameras().empty()) {
        std::cerr << "No se encontraron c�maras." << std::endl;
        return -1;
    }

    std::shared_ptr<Camera> camera = cameraManager->cameras()[0];

    // Abrir la c�mara
    if (camera->acquire()) {
        std::cerr << "No se pudo adquirir la c�mara." << std::endl;
        return -1;
    }

    // Configurar la c�mara para un flujo de video
    std::unique_ptr<CameraConfiguration> config = camera->generateConfiguration({ StreamRole::VideoRecording });

    // Configurar la resoluci�n y el formato
    StreamConfiguration &streamConfig = config->at(0);
    streamConfig.size.width = 1280;
    streamConfig.size.height = 720;
    streamConfig.pixelFormat = formats::RGB888;  // Formato RGB888

    // Validar la configuraci�n
    if (config->validate() == CameraConfiguration::Invalid) {
        std::cerr << "Configuraci�n inv�lida." << std::endl;
        camera->release();
        return -1;
    }

    // Aplicar la configuraci�n
    if (camera->configure(config.get())) {
        std::cerr << "No se pudo configurar la c�mara." << std::endl;
        camera->release();
        return -1;
    }

    // Crear un allocador de buffer para la c�mara
    FrameBufferAllocator *allocator = new FrameBufferAllocator(camera);
    globalAllocator = allocator;

    // Asignar buffers a los streams
    for (StreamConfiguration &cfg : *config) {
        if (allocator->allocate(cfg.stream()) < 0) {
            std::cerr << "Error al asignar buffers para el stream." << std::endl;
            camera->release();
            return -1;
        }
    }

    globalStream = streamConfig.stream();

    // Conectar el callback para capturas completadas (sin lambdas)
    camera->requestCompleted.connect(onRequestCompleted);

    // Iniciar la c�mara
    camera->start();

    // Bucle de captura continuo
    while (true) {
        // Crear una solicitud de captura
        std::shared_ptr<Request> request = camera->createRequest();
        const std::vector<std::unique_ptr<FrameBuffer>> &buffers = allocator->buffers(globalStream);
        request->addBuffer(globalStream, buffers[0].get());

        // Colocar la solicitud en cola
        camera->queueRequest(request.get());

        // Salir si se presiona una tecla
        if (cv::waitKey(1) >= 0) {
            break;
        }
    }

    // Liberar la c�mara y los recursos
    camera->stop();
    camera->release();
    cameraManager->stop();
    delete allocator;
    delete cameraManager;

    return 0;
}

