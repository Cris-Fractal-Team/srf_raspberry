}



void testPointer()
{
    GPointer ptr(new GLongObject(100));
    GLongObject *numero = (GLongObject *)&ptr;

    cout << "Valor del numero : " << numero->valor << " " << long(*numero) << endl;
    procesaReferencia(ptr);
