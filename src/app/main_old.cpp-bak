void conversaConCliente( GSocket con )
{
    char rpta[100];
    int e;

    try
    {
        con.readChar(rpta,100);    
        cout << "Mensaje desde el cliente: " << rpta << endl;
        con.writeString("Hola cliente");    
        con.readChar(rpta,100);
        cout << "Despedida del cliente: " << rpta << endl;
        con.writeString("adios amigo");
    }    
    catch( std::runtime_error &e )
    {
        cout << "Error conversando con el cliente " << e.what() << endl;
    }
        
    con.cerrar();
}

void sigpipe_handler(int unused)
{
    cout << "***** ERROR CON PIPE " << unused << endl;
}

void ejecutaServidor()
{
    GSocket socket,cliente;
  
    try
    {
        socket.iniciaServidor("localhost",8080);
    }
    catch( std::runtime_error &e )
    {
        cout << "El servidor se ejecuto el servidor " << endl;
        return;
    }

    cout << "Servidor Iniciado" << endl;

    while( socket.estaConectado() == 1 )
    {
        cout << "Esperando clientes" << endl;
        cliente = socket.aceptarCliente();
        if ( cliente.estaConectado() == 1 )
        {
            cout << "Cliente detectado" << endl;
            conversaConCliente(cliente);
        }
        else
        {
            cout << "Error al esperar un cliente";
        }
        if ( socket.estaConectado() == 0 ) break;
    }
    cout << "Servidor finalizado" << endl;
}


void ejecutaCliente()
{
    GSocket con;
    char rpta[100];
    int e;

    try
    {
        con.abrirConexion("localhost",8080,0);
        cout << "Se conecto con el servidor" << endl;

        con.writeString("Hola servidor");
        con.readChar(rpta,100);
        cout << "Mensaje desde el servidor: " << rpta << endl;
        con.writeString("adios");    
        con.readChar(rpta,100);    
        cout << "Despedida del servidor: " << rpta << endl;
    }
    catch( std::runtime_error &e )
    {
        cout << "Error :" << e.what() << endl;
    }
    
    con.cerrar();
}

unsigned long long getTotalSystemMemory()
{
    struct sysinfo info;
    sysinfo(&info);

    return info.freeram;
}


int testVector()
{    
    GVector vector;    
    long long i;
        
    cout << "Memoria antes del bucle :" << (getTotalSystemMemory()) << endl;
    
    for(i=0;i<10000;i++)
    {
        // GPointer p(new GLongObject(i));
        // vector.add(p);
        vector.add(new GLongObject(i));
    }

    cout << "Memoria despues del bucle :" << (getTotalSystemMemory()) << endl;
    vector.clear();
    cout << "Memoria despues de clear :" << (getTotalSystemMemory()) << endl;

    return 1;
}

void procesaReferencia( GPointer ptr )
{
